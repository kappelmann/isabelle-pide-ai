title = Isabelle PIDE MCP
module = $ISABELLE_PIDE_MCP_JAR
requirements = \
  env:ISABELLE_SCALA_JAR \
  env:SYMBOLS_JAR \
  env:ISABELLE_PIDE_AI_JAR
sources = \
  src/pide_mcp.scala \
  src/pide_mcp_protocol.scala \
  src/pide_mcp_endpoint.scala \
  src/pide_mcp_proxy_client_info.scala
services = \
  isabelle.pide.mcp.PIDE_MCP_Application \
  isabelle.pide.mcp.MCP_Protocols \
  isabelle.pide.mcp.MCP_Proxy_Client_Infos
