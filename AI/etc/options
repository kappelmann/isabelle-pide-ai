(* :mode=isabelle-options: *)

section "Server"

option pide_ai_exit_on_failed_option_sessions : bool = true for pide_ai
  -- "exit when a session specified in options fails to start"

option pide_ai_await_option_sessions : bool = true for pide_ai
  -- "await sessions specified in options before serving requests"

option pide_ai_log_long_running_threshold : real = 20 for pide_ai
  -- "threshold for long-running commands in the server's console and log file (seconds)"


section "Documents"

option pide_ai_range_context : int = 50 for pide_ai
  -- "lines around a read or edited range that are added to the PIDE perspective"

option pide_ai_unicode_symbols : bool = true for pide_ai
  -- "represent Isabelle symbols via Unicode"

option pide_ai_unicode_symbols_disk : bool = false for pide_ai
  -- "represent Isabelle symbols on disk via Unicode"


section "Sessions"

option pide_ai_build_long_running_threshold : real = 20 for pide_ai
  -- "threshold for long-running commands of session builds (seconds)"

option pide_ai_build_report_nodes_status_delay : real = 5 for pide_ai
  -- "minimum delay between nodes status reports of session builds (seconds)"

option pide_ai_long_running_threshold : real = 4 for pide_ai
  -- "threshold for long-running commands in live documents (seconds)"

option pide_ai_consolidate_delay : real = 0.2 for pide_ai
  -- "delay to consolidate theories after their commands have finished (seconds)"

option pide_ai_poll_delay : real = 0.02 for pide_ai
  -- "delay for polling during potentially blocking PIDE operations (seconds)"

option pide_ai_progress_delay : real = 5 for pide_ai
  -- "delay for progress messages of potentially blocking PIDE operations (seconds)"

option pide_ai_session_statistics_limit : int = 200 for pide_ai
  -- "maximum number of buffered runtime statistics samples per session"


section "Services"

option pide_ai_services_include : string = "*" for pide_ai
  -- "comma-separated names of services to run or \"*\" to run all"

option pide_ai_services_exclude : string = "" for pide_ai
  -- "comma-separated names of services not to run or \"*\" to run none"

option pide_ai_file_watcher_delay : real = 0.5 for pide_ai
  -- "delay for polling loaded files for external changes (seconds)"


section "Tools"

option pide_ai_tools_include : string = "*" for pide_ai
  -- "comma-separated names of tools to serve or \"*\" to serve all"

option pide_ai_tools_exclude : string = "" for pide_ai
  -- "comma-separated names of tools not to serve or \"*\" to serve none"

option pide_ai_get_state_delay : real = 0.02 for pide_ai
  -- "delay for checking command status while awaiting commands (seconds)"

option pide_ai_get_state_check_factor : real = 5 for pide_ai
  -- "minimum ratio of waiting to checking time while awaiting commands"

option pide_ai_get_state_progress_delay : real = 5 for pide_ai
  -- "delay for progress messages while awaiting commands (seconds)"


section "Protocols"

option pide_ai_protocols_include : string = "*" for pide_ai
  -- "comma-separated names of protocols to serve on the TCP port or \"*\" to serve all"

option pide_ai_protocols_exclude : string = "" for pide_ai
  -- "comma-separated names of protocols not to serve on the TCP port or \"*\" to serve none"

option pide_ai_protocol_handshake_timeout : real = 15 for pide_ai
  -- "timeout for the protocol handshake at the start of a connection (seconds)"


section "Clients"

option pide_ai_client_infos_include : string = "*" for pide_ai
  -- "comma-separated names of client infos to advertise or \"*\" to advertise all"

option pide_ai_client_infos_exclude : string = "" for pide_ai
  -- "comma-separated names of client infos not to advertise or \"*\" to advertise none"
